// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`i18n layout snapshots > keeps a Japanese Battle banner in the wrapping banner structure 1`] = `"<button class="state-banner state-banner--crimson" type="button"><span class="state-banner__glyph" aria-hidden="true">B</span><span class="state-banner__copy"><span class="state-banner__title">フロア3 解放！</span><span class="state-banner__hint">バトル結果を確認できます</span></span></button>"`;

exports[`i18n layout snapshots > keeps a long German Home CTA in the normal button flow 1`] = `"<button class="tw-button tw-button--primary tw-button--full" type="button">Belohnungen einsammeln und weiter zur naechsten Ebene</button>"`;

exports[`i18n layout snapshots > renders the zh-CN equipment empty state with the app shell text structure 1`] = `"<div class="equipment-page"><header class="equipment-header"><div><span>总战斗力</span><strong class="tw-display tw-num">1,284</strong></div><button aria-label="语言" type="button">⚙</button></header><div class="equipment-scroll tw-scroll"><section><div class="equipment-section-head">已装备</div><div class="equipment-slot-grid"><div class="slot-tile"><span class="slot-tile__icon"><svg aria-hidden="true" class="gear-icon gear-icon--common" fill="none" height="19" viewBox="0 0 24 24" width="19"><path d="M14.5 3.5 20 9 10.5 18.5 8 16 17.5 6.5ZM8 16 5 19M5 19 4 20M5 19 9 20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path></svg></span><span class="slot-tile__body"><span>武器</span><strong>空</strong></span></div><div class="slot-tile"><span class="slot-tile__icon"><svg aria-hidden="true" class="gear-icon gear-icon--common" fill="none" height="19" viewBox="0 0 24 24" width="19"><path d="M5 13a7 7 0 0 1 14 0v3h-3v-2h-2v2h-2v-2h-2v2H5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path></svg></span><span class="slot-tile__body"><span>头盔</span><strong>空</strong></span></div><div class="slot-tile"><span class="slot-tile__icon"><svg aria-hidden="true" class="gear-icon gear-icon--common" fill="none" height="19" viewBox="0 0 24 24" width="19"><path d="M8 4l4 2 4-2 3 3-2 2v10H7V9L5 7Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path></svg></span><span class="slot-tile__body"><span>护甲</span><strong>空</strong></span></div><div class="slot-tile"><span class="slot-tile__icon"><svg aria-hidden="true" class="gear-icon gear-icon--common" fill="none" height="19" viewBox="0 0 24 24" width="19"><path d="M12 9a5 5 0 1 0 .01 0ZM12 9l-1.5-4h3Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path></svg></span><span class="slot-tile__body"><span>戒指</span><strong>空</strong></span></div><div class="slot-tile"><span class="slot-tile__icon"><svg aria-hidden="true" class="gear-icon gear-icon--common" fill="none" height="19" viewBox="0 0 24 24" width="19"><path d="M5 5a10 8 0 0 0 14 0M12 13a2.4 2.4 0 1 0 .01 0Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path></svg></span><span class="slot-tile__body"><span>项链</span><strong>空</strong></span></div><div class="slot-tile"><span class="slot-tile__icon"><svg aria-hidden="true" class="gear-icon gear-icon--common" fill="none" height="19" viewBox="0 0 24 24" width="19"><path d="M8 4v10h6a3 3 0 0 1 3 3v2H6V4Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path></svg></span><span class="slot-tile__body"><span>战靴</span><strong>空</strong></span></div></div></section><div class="equipment-auto"><button aria-disabled="true" class="tw-button tw-button--ghost tw-button--full" disabled="" type="button">一键装备最佳</button></div><section><div class="equipment-section-head equipment-section-head--row"><span>背包</span><span class="tw-num">0</span></div><section class="empty-state"><div class="empty-state__mark" aria-hidden="true"></div><h2>背包为空</h2><p>击败据点可掉落新装备，掉落会出现在这里。</p></section></section></div></div>"`;
